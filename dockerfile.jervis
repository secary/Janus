FROM python:3.12-slim

WORKDIR /Jervis

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY predictor/requirements.txt /Jervis/predictor/requirements.txt
ENV TMPDIR=/var/tmp/pip-tmp \
    TEMP=/var/tmp/pip-tmp \
    TMP=/var/tmp/pip-tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_NO_INPUT=1
RUN mkdir -p /var/tmp/pip-tmp \
    && grep -v '^torch$' /Jervis/predictor/requirements.txt > /tmp/requirements.no-torch.txt \
    && pip install --no-cache-dir -r /tmp/requirements.no-torch.txt \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
    && rm -f /tmp/requirements.no-torch.txt \
    && rm -rf /var/tmp/pip-tmp

COPY config/ /Jervis/config/
COPY utils/ /Jervis/utils/
COPY predictor/ /Jervis/predictor/
COPY data/ /Jervis/data/

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "/Jervis/predictor/Jervis.py"]
