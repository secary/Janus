# 使用轻量 Python 镜像
FROM python:3.12-slim

# 设置工作目录
WORKDIR /Javelin

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY web/requirements.txt /Javelin/web/requirements.txt
ENV TMPDIR=/var/tmp/pip-tmp \
    TEMP=/var/tmp/pip-tmp \
    TMP=/var/tmp/pip-tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_NO_INPUT=1
RUN mkdir -p /var/tmp/pip-tmp \
    && pip install --no-cache-dir -r /Javelin/web/requirements.txt \
    && rm -rf /var/tmp/pip-tmp

# 拷贝网站代码和模板
COPY web/ /Javelin/web/
# 拷贝共享配置与模块
COPY config/ /Javelin/config/
COPY utils/ /Javelin/utils/

# 设置环境变量
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Flask 端口
EXPOSE 5000

# 启动 Flask
CMD ["python", "/Javelin/web/Javelin.py"]
