FROM python:3.12-slim

WORKDIR /Janus

RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

COPY main/requirements.txt /Janus/main/requirements.txt
ENV TMPDIR=/var/tmp/pip-tmp \
    TEMP=/var/tmp/pip-tmp \
    TMP=/var/tmp/pip-tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10 \
    PIP_NO_INPUT=1
RUN mkdir -p /var/tmp/pip-tmp \
    && pip install --no-cache-dir -r /Janus/main/requirements.txt \
    && rm -rf /var/tmp/pip-tmp

COPY config/ /Janus/config/
COPY utils/ /Janus/utils/
COPY main/ /Janus/main/
COPY predictor/ /Janus/predictor/
COPY data/ /Janus/data/

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "/Janus/main/Janus.py"]
